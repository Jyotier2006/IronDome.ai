{
  "name": "irondome-ai",
  "version": "2.0.0",
  "private": true,
  "description": "IronDome.ai - AI-based detection of cyber threats in unidirectional IP traffic (SIH PS 26145)",
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:sensor": "cd backend/sensor-service && python sensor_service.py",
    "dev": "npx concurrently -k -c \"green,cyan\" -n \"DASHBOARD,SENSOR\" \"npm run dev:frontend\" \"npm run dev:sensor\"",
    "demo": "cd frontend && npm run dev:mock",
    "train": "cd model_microservice && python model_training_pipeline.py",
    "evaluate": "cd model_microservice && python evaluate_pipeline.py",
    "test": "python -m unittest discover -s tests -v",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
